LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.example.com/v1
MODEL_ID=your-model
# Global sampling temperature for LLM calls (default: provider default)
# LLM_TEMPERATURE=0

# Root of everything the runtime persists: browser sessions, run traces
# and compaction summaries (default: <project>/workspace)
# AGENT_RUNTIME_HOME=./workspace
# Workspace root for file tools and execute_code scripts (default: cwd)
# AGENT_RUNTIME_WORKSPACE=./workspace
# Python binary used by execute_code (default: python3)
# AGENT_RUNTIME_PYTHON=python3
# Max stdout chars execute_code returns inline before spilling to .outputs/
# AGENT_RUNTIME_MAX_OUTPUT_CHARS=16000
# Dangerous-command guard for local execution: off | blocklist | allowlist  (default: blocklist)
# AGENT_RUNTIME_COMMAND_GUARD=blocklist

# Replay the model's reasoning back to the provider on history replay:
#   auto   (default) — replay for thinking-mode families (deepseek, glm, kimi,
#           moonshot, mimo, xiaomi, ling, …) matched via MODEL_ID/LLM_BASE_URL,
#           but never for a gateway that proxies them (OpenRouter drops the
#           reasoning before the model sees it, so replaying it is a no-op)
#   always — always replay (required by some gateways proxying echo families)
#   never  — never replay (strict providers that reject extra message fields)
# AGENT_RUNTIME_REASONING_ECHO=auto
